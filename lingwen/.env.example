# =============================================================================
# 天府一网监 Docker 环境变量模板
# 复制此文件为 .env 并填写实际值：
#   cp .env.example .env
# =============================================================================

# ---- MySQL 配置 ----
# MySQL root 密码（首次启动时初始化）
MYSQL_ROOT_PASSWORD=mysql_password

# ---- DeepSeek LLM API ----
LINGWEN_LLM_API_KEY=sk-your-deepseek-api-key-here
LINGWEN_LLM_MODEL=deepseek-chat

# ---- Embedding API（Gitee AI） ----
LINGWEN_EMBED_API_KEY=your-embedding-api-key
LINGWEN_EMBED_BASE_URL=https://ai.gitee.com/v1
LINGWEN_LLM_EMBED_MODEL=Qwen3-Embedding-8B

# ---- JWT 配置 ----
LINGWEN_JWT_SECRET=lingwen-docker-secret-2026
LINGWEN_JWT_EXPIRE_MINUTES=480
